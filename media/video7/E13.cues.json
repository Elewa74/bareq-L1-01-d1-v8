 "cues": [],
 "marks": [],
 "lines": [
  {
   "id": "bq7_E13_brq0",
   "t": 2.585,
   "end": 6.485,
   "sp": "BRQ",
   "text": "اُنْظُر إِلَى رَسْمِ مَاجِد. تَعَالَ نَعْرِف حِكَايَتَهُ."
  },
  {
   "id": "bq7_E13_n1",
   "t": 8.0,
   "end": 14.98,
   "sp": "HAB",
   "text": "اِسْتَيْقَظَ مَاجِدٌ مُبَكِّرًا. لَبِسَ قَمِيصَهُ، وَسَرَّحَ شَعْرَهُ بِالْمُشْطِ."
  },
  {
   "id": "bq7_E13_maj1",
   "t": 15.29,
   "end": 18.105,
   "sp": "MAJ",
   "text": "الْيَوْمَ نَزُورُ حَدِيقَةَ الْحَيَوَانِ."
  },
  {
   "id": "bq7_E13_n2",
   "t": 18.6,
   "end": 23.04,
   "sp": "HAB",
   "text": "وَضَعَ مَاجِدٌ مَانْجُو وَمَوْزًا فِي حَقِيبَتِهِ."
  },
  {
   "id": "bq7_E13_brq2",
   "t": 23.35,
   "end": 25.52,
   "sp": "BRQ",
   "text": "وَأَنَا أَحْمِلُ الْقَلَمَ."
  },
  {
   "id": "bq7_E13_n3b",
   "t": 26.01,
   "end": 30.76,
   "sp": "HAB",
   "text": "ذَهَبَ مَاجِدٌ وَسَيْفٌ مَعَ الْجَدَّةِ إِلَى حَدِيقَةِ الْحَيَوَانِ."
  },
  {
   "id": "bq7_E13_jda3",
   "t": 31.07,
   "end": 35.63,
   "sp": "JDA",
   "text": "أَمْسِكَا يَدِي يَا أَحِبَّائِي… هَيَّا نَدْخُل."
  },
  {
   "id": "bq7_E13_n4",
   "t": 39.215,
   "end": 42.025,
   "sp": "HAB",
   "text": "رَأَوُا النُّمُورَ تَلْعَبُ تَحْتَ الشَّجَرَةِ."
  },
  {
   "id": "bq7_E13_say4",
   "t": 42.515,
   "end": 45.345,
   "sp": "SAY",
   "text": "اُنْظُرَا، نُمُورٌ كَبِيرَةٌ."
  },
  {
   "id": "bq7_E13_n5",
   "t": 45.645,
   "end": 49.94,
   "sp": "HAB",
   "text": "وَعِنْدَ الْبُحَيْرَةِ، فَتَحَ التِّمْسَاحُ فَمَهُ."
  },
  {
   "id": "bq7_E13_brq5",
   "t": 51.975,
   "end": 54.315,
   "sp": "BRQ",
   "text": "يَا لَهُ مِن فَمٍ كَبِيرٍ."
  },
  {
   "id": "bq7_E13_maj5",
   "t": 55.015,
   "end": 58.305,
   "sp": "MAJ",
   "text": "لَا تَخَف يَا بَارِقُ. نَحْنُ بَعِيدُونَ."
  },
  {
   "id": "bq7_E13_n6",
   "t": 59.01,
   "end": 63.7,
   "sp": "HAB",
   "text": "جَلَسُوا تَحْتَ الظِّلِّ، وَأَكَلُوا الْمَانْجُو وَالْمَوْزَ."
  },
  {
   "id": "bq7_E13_jda6",
   "t": 63.995,
   "end": 66.715,
   "sp": "JDA",
   "text": "تَفَضَّلَا يَا وَلَدَيَّ."
  },
  {
   "id": "bq7_E13_say6",
   "t": 67.4,
   "end": 69.43,
   "sp": "SAY",
   "text": "الْمَانْجُو حُلْوَةٌ."
  },
  {
   "id": "bq7_E13_jda7",
   "t": 70.115,
   "end": 73.755,
   "sp": "JDA",
   "text": "اِرْبِطَا الْحِزَامَ… سَنَعُودُ إِلَى الْبَيْتِ."
  },
  {
   "id": "bq7_E13_n7",
   "t": 76.255,
   "end": 79.73,
   "sp": "HAB",
   "text": "فِي الْمَسَاءِ، ظَهَرَ الْقَمَرُ فِي السَّمَاءِ."
  },
  {
   "id": "bq7_E13_maj7",
   "t": 82.255,
   "end": 84.255,
   "sp": "MAJ",
   "text": "الْقَمَرُ جَمِيلٌ."
  },
  {
   "id": "bq7_E13_n8",
   "t": 84.855,
   "end": 89.555,
   "sp": "HAB",
   "text": "جَلَسَ مَاجِدٌ إِلَى مَكْتَبِهِ، وَرَسَمَ يَوْمَهُ بِالْقَلَمِ."
  },
  {
   "id": "bq7_E13_brq8",
   "t": 94.355,
   "end": 96.65,
   "sp": "BRQ",
   "text": "وَكَتَبْتَ حَرْفَ الْمِيمِ."
  },
  {
   "id": "bq7_E13_maj8b",
   "t": 99.35,
   "end": 105.56,
   "sp": "MAJ",
   "text": "حَرْفُ الْمِيمِ… صَوْتُهُ مَ. وَهُوَ فِي يَوْمِي كُلِّهِ."
  },
  {
   "id": "bq7_E13_brq9",
   "t": 109.45,
   "end": 111.8,
   "sp": "BRQ",
   "text": "تُصْبِحُ عَلَى خَيْرٍ يَا مَاجِدُ."
  }
 ],
