 "cues": [],
 "marks": [],
 "lines": [
  {
   "id": "bq7_E13_brq0",
   "t": 2.59,
   "end": 6.4,
   "sp": "BRQ",
   "text": "اُنْظُر إِلى رَسْمِ ماجِد! تَعالَ نَعْرِف حِكايَتَهُ."
  },
  {
   "id": "bq7_E13_n1",
   "t": 7.695,
   "end": 13.305,
   "sp": "HAB",
   "text": "اِسْتَيْقَظَ ماجِدٌ مُبَكِّرًا. لَبِسَ قَميصَهُ، وَسَرَّحَ شَعْرَهُ بِالمُشْطِ."
  },
  {
   "id": "bq7_E13_maj1",
   "t": 14.095,
   "end": 16.785,
   "sp": "MAJ",
   "text": "اليَوْمَ نَزورُ حَديقَةَ الحَيَوانِ!"
  },
  {
   "id": "bq7_E13_n2",
   "t": 17.28,
   "end": 20.71,
   "sp": "HAB",
   "text": "وَضَعَ ماجِدٌ مانْجو وَمَوْزًا في حَقيبَتِهِ."
  },
  {
   "id": "bq7_E13_brq2",
   "t": 21.3,
   "end": 23.09,
   "sp": "BRQ",
   "text": "وَأَنا أَحْمِلُ القَلَمَ!"
  },
  {
   "id": "bq7_E13_n3b",
   "t": 23.89,
   "end": 27.93,
   "sp": "HAB",
   "text": "أَخَذَتِ الجَدَّةُ ماجِدًا وَسَيْفًا إِلى حَديقَةِ الحَيَوانِ."
  },
  {
   "id": "bq7_E13_jda3",
   "t": 28.495,
   "end": 31.455,
   "sp": "JDA",
   "text": "أَمْسِكا يَدي يا وَلَدَيَّ… هَيّا نَدْخُل!"
  },
  {
   "id": "bq7_E13_n4",
   "t": 35.59,
   "end": 38.07,
   "sp": "HAB",
   "text": "رَأَوُا النُّمورَ تَلْعَبُ تَحْتَ الشَّجَرَةِ."
  },
  {
   "id": "bq7_E13_say4",
   "t": 38.895,
   "end": 41.325,
   "sp": "SAY",
   "text": "اُنْظُرا! نُمورٌ كَبيرَةٌ!"
  },
  {
   "id": "bq7_E13_n5",
   "t": 41.7,
   "end": 45.07,
   "sp": "HAB",
   "text": "وَعِنْدَ البُحَيْرَةِ، فَتَحَ التِّمْساحُ فَمَهُ."
  },
  {
   "id": "bq7_E13_brq5",
   "t": 47.495,
   "end": 49.505,
   "sp": "BRQ",
   "text": "يا لَهُ مِن فَمٍ كَبيرٍ!"
  },
  {
   "id": "bq7_E13_maj5",
   "t": 50.3,
   "end": 53.69,
   "sp": "MAJ",
   "text": "لا تَخَف يا بارِقُ! نَحْنُ بَعيدونَ."
  },
  {
   "id": "bq7_E13_n6",
   "t": 54.295,
   "end": 58.115,
   "sp": "HAB",
   "text": "جَلَسوا تَحْتَ الظِّلِّ، وَأَكَلُوا المانْجو وَالمَوْزَ."
  },
  {
   "id": "bq7_E13_jda6",
   "t": 58.685,
   "end": 60.635,
   "sp": "JDA",
   "text": "تَفَضَّلا يا وَلَدَيَّ!"
  },
  {
   "id": "bq7_E13_say6",
   "t": 61.325,
   "end": 62.665,
   "sp": "SAY",
   "text": "المانْجو حُلْوَةٌ!"
  },
  {
   "id": "bq7_E13_jda7",
   "t": 63.92,
   "end": 66.75,
   "sp": "JDA",
   "text": "اِرْبِطا الحِزامَ… سَنَعودُ إِلى البَيْتِ."
  },
  {
   "id": "bq7_E13_n7",
   "t": 69.335,
   "end": 72.405,
   "sp": "HAB",
   "text": "في المَساءِ، ظَهَرَ القَمَرُ في السَّماءِ."
  },
  {
   "id": "bq7_E13_maj7",
   "t": 75.33,
   "end": 77.1,
   "sp": "MAJ",
   "text": "القَمَرُ جَميلٌ!"
  },
  {
   "id": "bq7_E13_n8",
   "t": 77.83,
   "end": 81.64,
   "sp": "HAB",
   "text": "جَلَسَ ماجِدٌ إِلى مَكْتَبِهِ، وَرَسَمَ يَوْمَهُ بِالقَلَمِ."
  },
  {
   "id": "bq7_E13_brq8",
   "t": 87.335,
   "end": 89.18,
   "sp": "BRQ",
   "text": "وَكَتَبْتَ حَرْفَ المِيمِ!"
  },
  {
   "id": "bq7_E13_maj8b",
   "t": 91.935,
   "end": 96.805,
   "sp": "MAJ",
   "text": "حَرْفُ المِيمِ… صَوْتُهُ مَ! وَهُوَ في يَوْمي كُلِّهِ!"
  },
  {
   "id": "bq7_E13_brq9",
   "t": 100.93,
   "end": 103.22,
   "sp": "BRQ",
   "text": "تُصْبِحُ عَلى خَيْرٍ يا ماجِدُ!"
  }
 ],
