 "cues": [],
 "marks": [],
 "lines": [
  {
   "id": "bq7_E13_brq0",
   "t": 2.59,
   "end": 6.4,
   "sp": "BRQ",
   "text": "اُنْظُر إِلَى رَسْمِ مَاجِد. تَعَالَ نَعْرِف حِكَايَتَهُ."
  },
  {
   "id": "bq7_E13_n1",
   "t": 7.615,
   "end": 13.556,
   "sp": "HAB",
   "text": "اِسْتَيْقَظَ مَاجِدٌ مُبَكِّرًا. لَبِسَ قَمِيصَهُ، وَسَرَّحَ شَعْرَهُ بِالْمُشْطِ."
  },
  {
   "id": "bq7_E13_maj1",
   "t": 14.095,
   "end": 16.785,
   "sp": "MAJ",
   "text": "الْيَوْمَ نَزُورُ حَدِيقَةَ الْحَيَوَانِ."
  },
  {
   "id": "bq7_E13_n2",
   "t": 17.28,
   "end": 20.71,
   "sp": "HAB",
   "text": "وَضَعَ مَاجِدٌ مَانْجُو وَمَوْزًا فِي حَقِيبَتِهِ."
  },
  {
   "id": "bq7_E13_brq2",
   "t": 21.3,
   "end": 23.09,
   "sp": "BRQ",
   "text": "وَأَنَا أَحْمِلُ الْقَلَمَ."
  },
  {
   "id": "bq7_E13_n3b",
   "t": 23.89,
   "end": 27.93,
   "sp": "HAB",
   "text": "أَخَذَتِ الْجَدَّةُ مَاجِدًا وَسَيْفًا إِلَى حَدِيقَةِ الْحَيَوَانِ."
  },
  {
   "id": "bq7_E13_jda3",
   "t": 28.495,
   "end": 31.455,
   "sp": "JDA",
   "text": "أَمْسِكَا يَدِي يَا وَلَدَيَّ… هَيَّا نَدْخُل."
  },
  {
   "id": "bq7_E13_n4",
   "t": 34.19,
   "end": 36.67,
   "sp": "HAB",
   "text": "رَأَوُا النُّمُورَ تَلْعَبُ تَحْتَ الشَّجَرَةِ."
  },
  {
   "id": "bq7_E13_say4",
   "t": 37.495,
   "end": 39.925,
   "sp": "SAY",
   "text": "اُنْظُرَا، نُمُورٌ كَبِيرَةٌ."
  },
  {
   "id": "bq7_E13_n5",
   "t": 40.3,
   "end": 43.67,
   "sp": "HAB",
   "text": "وَعِنْدَ الْبُحَيْرَةِ، فَتَحَ التِّمْسَاحُ فَمَهُ."
  },
  {
   "id": "bq7_E13_brq5",
   "t": 46.095,
   "end": 48.105,
   "sp": "BRQ",
   "text": "يَا لَهُ مِن فَمٍ كَبِيرٍ."
  },
  {
   "id": "bq7_E13_maj5",
   "t": 48.9,
   "end": 52.29,
   "sp": "MAJ",
   "text": "لَا تَخَف يَا بَارِقُ. نَحْنُ بَعِيدُونَ."
  },
  {
   "id": "bq7_E13_n6",
   "t": 52.895,
   "end": 56.715,
   "sp": "HAB",
   "text": "جَلَسُوا تَحْتَ الظِّلِّ، وَأَكَلُوا الْمَانْجُو وَالْمَوْزَ."
  },
  {
   "id": "bq7_E13_jda6",
   "t": 57.285,
   "end": 59.235,
   "sp": "JDA",
   "text": "تَفَضَّلَا يَا وَلَدَيَّ."
  },
  {
   "id": "bq7_E13_say6",
   "t": 59.925,
   "end": 61.265,
   "sp": "SAY",
   "text": "الْمَانْجُو حُلْوَةٌ."
  },
  {
   "id": "bq7_E13_jda7",
   "t": 62.52,
   "end": 65.35,
   "sp": "JDA",
   "text": "اِرْبِطَا الْحِزَامَ… سَنَعُودُ إِلَى الْبَيْتِ."
  },
  {
   "id": "bq7_E13_n7",
   "t": 67.935,
   "end": 71.005,
   "sp": "HAB",
   "text": "فِي الْمَسَاءِ، ظَهَرَ الْقَمَرُ فِي السَّمَاءِ."
  },
  {
   "id": "bq7_E13_maj7",
   "t": 73.93,
   "end": 75.7,
   "sp": "MAJ",
   "text": "الْقَمَرُ جَمِيلٌ."
  },
  {
   "id": "bq7_E13_n8",
   "t": 76.43,
   "end": 80.24,
   "sp": "HAB",
   "text": "جَلَسَ مَاجِدٌ إِلَى مَكْتَبِهِ، وَرَسَمَ يَوْمَهُ بِالْقَلَمِ."
  },
  {
   "id": "bq7_E13_brq8",
   "t": 85.935,
   "end": 87.78,
   "sp": "BRQ",
   "text": "وَكَتَبْتَ حَرْفَ الْمِيمِ."
  },
  {
   "id": "bq7_E13_maj8b",
   "t": 90.535,
   "end": 95.405,
   "sp": "MAJ",
   "text": "حَرْفُ الْمِيمِ… صَوْتُهُ مَ. وَهُوَ فِي يَوْمِي كُلِّهِ."
  },
  {
   "id": "bq7_E13_brq9",
   "t": 99.53,
   "end": 101.82,
   "sp": "BRQ",
   "text": "تُصْبِحُ عَلَى خَيْرٍ يَا مَاجِدُ."
  }
 ],
